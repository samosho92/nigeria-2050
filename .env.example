# Public site URL for metadata, OG images, sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://naija2050.org

# Optional: Plausible Analytics domain (e.g. naija2050.org)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=naija2050.org

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: webhook for correction form submissions (Slack, Zapier, etc.)
# CORRECTIONS_WEBHOOK_URL=https://example.com/webhook

# Upstash Redis (required for Street Pulse polls)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
