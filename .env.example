# Copy to `.env.local` for local development. Never commit real secrets.
# Production values go in Vercel → Settings → Environment Variables (see docs/DEPLOY.md).

# Public site URL for metadata, OG images, sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://nigeria2050.com

# Optional: Plausible Analytics domain (e.g. nigeria2050.com)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nigeria2050.com

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Upstash Redis (required in Vercel Production for Street Pulse ballots)
# Leave unset locally to use data/polls-runtime.json
# Create a free database at https://console.upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Street Pulse export + ballot field hashing (≥32 chars). Bearer-only:
#   Authorization: Bearer <POLLS_EXPORT_SECRET>
# Set before launch; do not rotate without a ballot migration.
# POLLS_EXPORT_SECRET=

# Optional HTTPS webhooks (Slack, Zapier, etc.)
# POLLS_WEBHOOK_URL=https://example.com/webhook
# CORRECTIONS_WEBHOOK_URL=https://example.com/webhook
# PROJECTS_WEBHOOK_URL=https://example.com/webhook
